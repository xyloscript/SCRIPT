local function CleanupESP(envPrefix)
    local connections={"RemoteConnection","DataConnection","RoundEndConnection","RoundStartConnection","PlayerAdded","PlayerRemoving"}
    for _,name in ipairs(connections) do local conn=getgenv()[envPrefix..name]; if conn then conn:Disconnect(); getgenv()[envPrefix..name]=nil end end
    local loop=getgenv()[envPrefix.."RefreshLoop"]; if loop then task.cancel(loop); getgenv()[envPrefix.."RefreshLoop"]=nil end
    local charConns=getgenv()[envPrefix.."Connections"]; if charConns then for _,conn in pairs(charConns) do if conn then conn:Disconnect() end end; getgenv()[envPrefix.."Connections"]={} end
    local objects=getgenv()[envPrefix.."Objects"]; if objects then for _,obj in pairs(objects) do if obj then pcall(function() obj:Destroy() end) end end; getgenv()[envPrefix.."Objects"]={} end
    getgenv()[envPrefix:gsub("ESP","").."Roles"]={}
end

local function GetToolType(player)
    local bp=player:FindFirstChild("Backpack"); local ch=player.Character
    if bp then if bp:FindFirstChild("Gun") then return "Gun" end; if bp:FindFirstChild("Knife") then return "Knife" end end
    if ch then if ch:FindFirstChild("Gun") then return "Gun" end; if ch:FindFirstChild("Knife") then return "Knife" end end
    return nil
end

local function GetRoleColor(player, playerRoles)
    for id,data in pairs(playerRoles) do
        if data and typeof(data)=="table" then
            if tostring(id)==tostring(player.UserId) or id==player.Name then
                if data.Role=="Murderer" then return Color3.new(1,0,0) end
                if data.Role=="Sheriff"  then return Color3.new(0,0.5,1) end
                if data.Role=="Hero"     then return Color3.fromRGB(255,215,0) end
                return Color3.new(0,1,0)
            end
        end
    end
    local t=GetToolType(player)
    if t=="Gun"   then return Color3.new(0,0.5,1) end
    if t=="Knife" then return Color3.new(1,0,0) end
