-- FORWARD DECLARATION: applyTransparency is defined later but called from addTab click handler
local applyTransparency

local function addTab(name, icon)
    local btn = Instance.new("TextButton", sbScroll)
    btn.Size = UDim2.new(1,0,0,32); btn.BackgroundColor3 = tbl5.bgRow
    btn.BackgroundTransparency = 1; btn.BorderSizePixel = 0
    btn.Text = ""; btn.AutoButtonColor = false; btn.ZIndex = 8
    btn.LayoutOrder = #tabDefs + 1
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,6)
    local ic = Instance.new("ImageLabel", btn)
    ic.Image = icon; ic.ImageColor3 = tbl5.textDim; ic.BackgroundTransparency = 1
    ic.Size = UDim2.new(0,16,0,16); ic.Position = UDim2.new(0,10,0.5,-8); ic.ZIndex = 9
    local lb = Instance.new("TextLabel", btn)
    lb.Size = UDim2.new(1,-32,1,0); lb.Position = UDim2.new(0,32,0,0)
    lb.BackgroundTransparency = 1; lb.Text = name; lb.TextColor3 = tbl5.textDim
    lb.TextSize = 12; lb.Font = Enum.Font.GothamMedium
    lb.TextXAlignment = Enum.TextXAlignment.Left; lb.ZIndex = 9
    table.insert(tabDefs, {name=name, btn=btn, ic=ic, lb=lb})
    btn.MouseButton1Click:Connect(function()
        for n, p in pairs(pages) do p.Visible = (n == name) end
        -- Re-apply transparency on every tab switch so ALL rows stay consistent
        if applyTransparency then applyTransparency(tbl3.UITransparency) end
        for _, d in ipairs(tabDefs) do
            local active = (d.name == name)
            TweenService:Create(d.btn, TweenInfo.new(0.15), {BackgroundTransparency = active and 0 or 1, BackgroundColor3 = active and tbl5.bgRowHi or tbl5.bgRow}):Play()
            TweenService:Create(d.ic,  TweenInfo.new(0.15), {ImageColor3 = active and tbl5.accentHi or tbl5.textDim}):Play()
            TweenService:Create(d.lb,  TweenInfo.new(0.15), {TextColor3  = active and tbl5.text     or tbl5.textDim}):Play()
        end
    end)
    btn.MouseEnter:Connect(function()
        if pages[name] and not pages[name].Visible then
            TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundTransparency=0.7, BackgroundColor3=tbl5.bgRow}):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        if pages[name] and not pages[name].Visible then
            TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundTransparency=1}):Play()
        end
    end)
    return btn
end

