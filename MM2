        if not(aimbotEnabled and aimbotActive) then aimbotLocked=nil; return end
        if aimbotLocked and not isValidTarget(aimbotLocked) then aimbotLocked=nil end
        if not aimbotLocked then aimbotLocked=findTarget() end
        if not aimbotLocked then return end
        local hrp=aimbotLocked.Character and aimbotLocked.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then aimbotLocked=nil; return end
        local predicted=hrp.Position+hrp.Velocity*getPred()
        local cf=CFrame.new(currentCamera.CFrame.Position,predicted)
        if aimbotSmooth>0 then TweenService:Create(currentCamera,TweenInfo.new(aimbotSmooth,Enum.EasingStyle.Sine),{CFrame=cf}):Play()
        else currentCamera.CFrame=cf end
    end)

    UserInputService.TextBoxFocused:Connect(function() textFocused=true end)
    UserInputService.TextBoxFocusReleased:Connect(function() textFocused=false end)
    UserInputService.InputBegan:Connect(function(input,gp)
        if gp or textFocused or not aimbotEnabled then return end
        if input.KeyCode==Enum.KeyCode[aimbotKey] then
            if aimbotToggle then aimbotActive=not aimbotActive; if not aimbotActive then aimbotLocked=nil end
            else aimbotActive=true end
        end
    end)
    UserInputService.InputEnded:Connect(function(input,gp)
        if gp or aimbotToggle then return end
        if input.KeyCode==Enum.KeyCode[aimbotKey] then aimbotActive=false; aimbotLocked=nil end
    end)

