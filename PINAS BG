-- DRAG sideBtn + TOGGLE
-- ============================================================
local suppress = false
sideBtn.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        suppress = false
        local startPos   = sideBtn.Position
        local startMouse = i.Position
        local dragConn
        dragConn = UserInputService.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - startMouse
                if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then
                    suppress = true
                    local vp = currentCamera.ViewportSize
                    sideBtn.Position = UDim2.new(
                        startPos.X.Scale,
                        math.clamp(startPos.X.Offset + delta.X, -(vp.X-54), 0),
                        startPos.Y.Scale,
                        math.clamp(startPos.Y.Offset + delta.Y, -27, vp.Y-54)
                    )
                    frame.Position = UDim2.new(1,-(SB+14),0.5, sideBtn.Position.Y.Offset)
                end
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                if dragConn then dragConn:Disconnect() end
            end
        end)
    end
end)
sideBtn.MouseButton1Click:Connect(function()
    if not suppress then frame.Visible = not frame.Visible end
end)

-- DRAG titleBar
local hdrag, hds, hsp = false, nil, nil
titleBar.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        hdrag = true
        hds = Vector2.new(i.Position.X, i.Position.Y)
        hsp = frame.Position
    end
end)
UserInputService.InputChanged:Connect(function(i)
    if not hdrag then return end
    if i.UserInputType ~= Enum.UserInputType.MouseMovement
    and i.UserInputType ~= Enum.UserInputType.Touch then return end
    local d = Vector2.new(i.Position.X, i.Position.Y) - hds
    frame.Position = UDim2.new(hsp.X.Scale, hsp.X.Offset+d.X, hsp.Y.Scale, hsp.Y.Offset+d.Y)
end)
UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then hdrag = false end
end)

UserInputService.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.KeyCode == Enum.KeyCode.RightShift then frame.Visible = not frame.Visible end
end)

-- Mobile viewport auto-scale
local function updateScaleForViewport()
    if not isMobile then return end
    local vp = currentCamera.ViewportSize
    if vp.X < 900 or vp.Y < 600 then
        uiScaleInst.Scale = math.clamp(
            math.min((vp.X*0.9)/WIDE_HW, (vp.Y*0.9)/WIDE_HH), 0.4, tbl3.UIScale)
    else
        uiScaleInst.Scale = tbl3.UIScale
    end
end
currentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScaleForViewport)
task.defer(function() task.wait(0.1); updateScaleForViewport() end)

