local FFC  = Workspace.FindFirstChild
local GetP = Players.GetPlayers
local GetD = Workspace.GetDescendants
local IsA2 = Workspace.IsA
local FFCC = Workspace.FindFirstChildOfClass
local unp  = table.unpack or unpack
local mrand= math.random

local function DistanceCheck(Player, Distance)
    if not Player then return false end
    if Player.Character and FFC(Player.Character,"HumanoidRootPart") then
        return Distance > (currentCamera.CFrame.Position - FFC(Player.Character,"HumanoidRootPart").Position).Magnitude
    end return false
end

local function WallCheck(Character, TargetPart)
    TargetPart = TargetPart or (Character and FFC(Character,"Head"))
    if not Character or not TargetPart or not TargetPart:IsDescendantOf(Character) then return false end
    local LC=localPlayer.Character; local LH=LC and LC:FindFirstChild("HumanoidRootPart")
    local P=RaycastParams.new(); P.FilterDescendantsInstances={LC,currentCamera}; P.FilterType=Enum.RaycastFilterType.Blacklist; P.IgnoreWater=true
    local co=currentCamera.CFrame.Position; local cd=TargetPart.Position-co
    local cr=Workspace:Raycast(co,cd,P)
    local cc=not cr or (cr.Instance and cr.Instance:IsDescendantOf(Character))
    local hc=true
    if LH then
        local ho=LH.Position; local hd=TargetPart.Position-ho
        local hr=Workspace:Raycast(ho,hd,P)
        hc=not hr or (hr.Instance and hr.Instance:IsDescendantOf(Character))
    end
    return cc and hc
end

local function IsTeammate(TP)
    if not TP then return false end
    local LC=localPlayer.Character; local TC=TP.Character
    if LC and TC then
        local LM=LC:GetAttribute("MatchId"); local TM=TC:GetAttribute("MatchId")
        if LM~=nil or TM~=nil then
            local LT=LC:GetAttribute("PvPTeam"); local TT=TC:GetAttribute("PvPTeam")
            return LM~=nil and LM==TM and LT~=nil and TT~=nil and LT==TT
        end
    end
    local LS=localPlayer:GetAttribute("StageTeamSide"); local TS2=TP:GetAttribute("StageTeamSide")
    if typeof(LS)=="number" and typeof(TS2)=="number" then return LS==TS2 end
    if localPlayer.Neutral or TP.Neutral then return false end
    return localPlayer.Team~=nil and TP.Team==localPlayer.Team
end

local function GetAimScreenPos()
    local vp=currentCamera.ViewportSize return Vector2.new(vp.X*0.5,vp.Y*0.5)
end

local SilentTarget = nil
local AssistTarget = nil
local AssistTargetPart = nil

-- SILENT AIM TARGET SCAN
local function GetClosestSilent()
    local VPs={}
    for _,V in GetP(Players) do
        if V==localPlayer then continue end
        if Config.Silent.TeamCheck and IsTeammate(V) then continue end
        if V.Character and FFC(V.Character,"HumanoidRootPart") and FFC(V.Character,"Humanoid") and FFC(V.Character,"Humanoid").Health>(Game_Name=="South Bronx" and 4 or 0) then
            if FFCC(V.Character,"ForceField") then continue end
            if V.Character.Parent==nil then continue end
            local TP=FFC(V.Character,"HumanoidRootPart"); local ML=GetAimScreenPos()
            local TPP,OnS=currentCamera:WorldToViewportPoint(TP.Position)
            local R=Config.Silent.UseFieldOfView and Config.Silent.Radius or 9e9
            local Mag=(Vector2.new(TPP.X,TPP.Y)-ML).Magnitude
            if not DistanceCheck(V,Config.Silent.MaxDistance) then continue end
            if R>Mag and OnS then
                if not Config.Silent.WallBang and Config.Silent.WallCheck and not WallCheck(V.Character) then continue end
                table.insert(VPs,{Player=V,Distance=Mag})
            end
        end
    end
    table.sort(VPs,function(a,b) return a.Distance<b.Distance end)
    return VPs[1] and VPs[1].Player or nil
end

-- AIM ASSIST TARGET SCAN
local function GetClosestAssist()
    local VPs={}
    for _,V in GetP(Players) do
        if V==localPlayer then continue end
        if Config.AimAssist.TeamCheck and IsTeammate(V) then continue end
        if V.Character and FFC(V.Character,"HumanoidRootPart") and FFC(V.Character,"Humanoid") and FFC(V.Character,"Humanoid").Health>0 then
            if FFCC(V.Character,"ForceField") then continue end
            if V.Character.Parent==nil then continue end
            
            local TPart = FFC(V.Character, Config.AimAssist.TargetPart) or FFC(V.Character,"HumanoidRootPart")
            if TPart then
                local ML=GetAimScreenPos()
                local TPP,OnS=currentCamera:WorldToViewportPoint(TPart.Position)
                local Mag=(Vector2.new(TPP.X,TPP.Y)-ML).Magnitude
                
                if DistanceCheck(V,Config.AimAssist.MaxDistance) and Config.AimAssist.FOV > Mag and OnS then
                    if Config.AimAssist.WallCheck and not WallCheck(V.Character, TPart) then continue end
                    table.insert(VPs,{Player=V, Part=TPart, Distance=Mag})
                end
            end
        end
    end
    table.sort(VPs,function(a,b) return a.Distance<b.Distance end)
    return VPs[1] and VPs[1].Player or nil, VPs[1] and VPs[1].Part or nil
end

-- SILENT AIM HOOK
local __namecall = nil
pcall(function()
    if Solara then return end
    if type(hookmetamethod)~="function" or type(getnamecallmethod)~="function" or type(checkcaller)~="function" then return end
    __namecall=hookmetamethod(Workspace,"__namecall",function(...)
        local Arguments={...}; local Method=getnamecallmethod()
        if checkcaller() then return __namecall(...) end
        if not SilentTarget or not Config.Silent.Enabled then return __namecall(...) end
        local CallScript=nil pcall(function() CallScript=getcallingscript() end)
        if Game_Name=="Town" then if tostring(CallScript)~="GunScript" then return __namecall(...) end end
        if not (mrand(0,100)<=Config.Silent.HitChance) then return __namecall(...) end
        if Game_Name=="The Bronx" then
            if not (CallScript and (CallScript.Name=="GunScript_Local" or CallScript.Name=="BulletVisualizerServerScript" or CallScript.Name=="BulletVisualizerClientScript")) then return __namecall(...) end
        end
        local RP=Config.Silent.TargetPart[1] and Config.Silent.TargetPart[mrand(1,#Config.Silent.TargetPart)] or "Head"
        if Method=="Raycast" and table.find(Config.Game.Ray_Systems,"Raycast") then
            local RO,RD=Arguments[2],Arguments[3]
            if typeof(RO)~="Vector3" or typeof(RD)~="Vector3" or RD.Magnitude<25 then return __namecall(...) end
            if Game_Name=="BlockSpin" then if CallScript and not (CallScript.Name=="Gun") then return __namecall(...) end end
            if Game_Name=="South Bronx" then if CallScript and CallScript.Name=="RealismClient" then return __namecall(...) end end
            if Config.Silent.Enabled and Config.Silent.Targetting then
                local T=SilentTarget
                if T and T.Character and FFC(T.Character,RP) and FFC(T.Character,"Humanoid") and FFC(T.Character,"Humanoid").Health~=0 then
                    Arguments[3]=(FFC(T.Character,RP).Position-Arguments[2]).Unit*1000
                end
                if Config.Silent.WallBang and Game_Name~="BlockSpin" and SilentTarget and SilentTarget.Character then
                    local FDI={}
                    for _,V in pairs(GetD(SilentTarget.Character)) do if IsA2(V,"Part") or IsA2(V,"BasePart") or IsA2(V,"MeshPart") then table.insert(FDI,V) end end
                    local rp2=RaycastParams.new(); rp2.FilterType=Enum.RaycastFilterType.Include; rp2.IgnoreWater=false; rp2.RespectCanCollide=false; rp2.FilterDescendantsInstances=FDI; Arguments[4]=rp2
                end
                if not Config.Silent.WallBang and Game_Name=="South Bronx" then
                    local rp2=RaycastParams.new(); rp2.FilterType=Enum.RaycastFilterType.Blacklist; rp2.FilterDescendantsInstances={localPlayer.Character}; Arguments[4]=rp2
                end
                return __namecall(unp(Arguments))
            end
        end
        if string.find(string.lower(Method),"findpartonray") and
            (table.find(Config.Game.Ray_Systems,"FindPartOnRay") or table.find(Config.Game.Ray_Systems,"FindPartOnRayWithWhitelist")) then
            local Ray=Arguments[2]
            if typeof(Ray)~="Ray" or Ray.Direction.Magnitude<25 then return __namecall(...) end
            if Config.Silent.Enabled and Config.Silent.Targetting then
                local T=SilentTarget
                if T and T.Character and FFC(T.Character,RP) and FFC(T.Character,"Humanoid") and FFC(T.Character,"Humanoid").Health~=0 then
                    local TPart=FFC(T.Character,RP); local Dir=(TPart.Position-Arguments[2].Origin).Unit*9e17
                    Arguments[2]=Ray.new(Arguments[2].Origin,Dir)
                    if Config.Silent.WallBang then return TPart,TPart.Position,Vector3.new(0,0,0) end
                    return __namecall(unp(Arguments))
                end
            end
        end
        return __namecall(...)
    end)
end)

