local function LoadConfig()
    local ok, r = pcall(function() return readfile("xylopinas_config.json") end)
    if not ok or not r or r == "" then return end
    local ok2, data = pcall(function() return HttpService:JSONDecode(r) end)
    if not ok2 or type(data) ~= "table" then return end

    if data.UI then
        for k, v in pairs(tbl2) do
            if data.UI[k] ~= nil and type(data.UI[k]) == type(v) and k ~= "UIScale" then tbl3[k] = data.UI[k] end
        end
        if data.UI.UIScale then tbl3.UIScale = data.UI.UIScale end
    end
    if data.Silent then
        for k, v in pairs(Config.Silent) do
            if data.Silent[k] ~= nil then
                if type(data.Silent[k]) == "table" and k == "TargetPart" then Config.Silent.TargetPart = data.Silent[k]
                elseif type(data.Silent[k]) == "boolean" or type(data.Silent[k]) == "number" or type(data.Silent[k]) == "string" then Config.Silent[k] = data.Silent[k] end
            end
        end
    end
    if data.AimAssist then
        for k, v in pairs(Config.AimAssist) do
            if data.AimAssist[k] ~= nil and type(data.AimAssist[k]) == type(v) then Config.AimAssist[k] = data.AimAssist[k] end
        end
    end
    if data.ESP then
        for k, v in pairs(Config.ESP) do
            if data.ESP[k] ~= nil and type(data.ESP[k]) == type(v) then Config.ESP[k] = data.ESP[k] end
        end
    end
end

