-- ESP RENDER LOOP & AIM ASSIST LOGIC
-- ============================================================
local function hideNameTag(char)
    local bb = char:FindFirstChild("XYLONameTag")
    if bb then bb:Destroy() end
end

local function resetPlayerParts(player)
    if not player or not player.Character then return end
    local char = player.Character
    local vb = char:FindFirstChild("XYLOVisualBox")
    if vb then vb:Destroy() end
    local chams = char:FindFirstChild("XYLOChams")
    if chams then
        chams:Destroy()
        for _,p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.Material = Enum.Material.Plastic end
        end
    end
    hideNameTag(char)
end

local triggerTimer = 0

RunService.RenderStepped:Connect(function(dt)
    RainbowHue = (RainbowHue + dt*0.2)%1
    local center = Vector2.new(currentCamera.ViewportSize.X/2, currentCamera.ViewportSize.Y/2)

    -- AIM ASSIST LOGIC
    local aaTarget, aaPart = GetClosestAssist()
    if Config.AimAssist.Enabled and aaTarget and aaPart then
        local targetPos = aaPart.Position
        local currentCFrame = currentCamera.CFrame
        local lookAt = CFrame.new(currentCFrame.Position, targetPos)
        
        local smooth = Config.AimAssist.Smoothness
        if smooth <= 0.05 then smooth = 0.05 end
        
        -- Smoothly lerp camera to target
        currentCamera.CFrame = currentCFrame:Lerp(lookAt, smooth * Config.AimAssist.Sensitivity)
    end

    -- TRIGGERBOT LOGIC
    if Config.AimAssist.Triggerbot then
        triggerTimer = triggerTimer - dt
        if triggerTimer <= 0 then
            local tPart = FFC(localPlayer.Character, Config.AimAssist.TargetPart)
            if tPart then
                local ray = currentCamera:ViewportPointToRay(center.X, center.Y)
                local rcp = RaycastParams.new()
                rcp.FilterType = Enum.RaycastFilterType.Exclude
                rcp.FilterDescendantsInstances = {localPlayer.Character}
                local result = Workspace:Raycast(ray.Origin, ray.Direction * 1000, rcp)
                if result and result.Instance then
                    local hitChar = result.Instance:FindFirstAncestorOfClass("Model")
                    local hitPlayer = hitChar and Players:GetPlayerFromCharacter(hitChar)
                    if hitPlayer and hitPlayer ~= localPlayer and IsTeammate(hitPlayer) == false then
                        local tool = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Tool")
                        if tool then
                            tool:Activate()
                            triggerTimer = Config.AimAssist.TriggerDelay
                        end
                    end
                end
            end
        end
    end

    -- SILENT AIM VISUALS
    local ML = GetAimScreenPos()
    pcall(function() SilentTarget = GetClosestSilent() end)

    -- ESP LOGIC
    local tracerCenter = Config.ESP.TracerOrigin=="Bottom" and Vector2.new(center.X, currentCamera.ViewportSize.Y) or Config.ESP.TracerOrigin=="Center" and center or UserInputService:GetMouseLocation()
    local pi = 1

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer then
            local char = player.Character
            if char then
                local hum = char:FindFirstChild("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and hrp then
                    if Config.Silent.TeamCheck and IsTeammate(player) then
                        resetPlayerParts(player)
                        hideESP(player.UserId)
                    else
                        local hl = char:FindFirstChild("XYLOESP")
                        if Config.ESP.Enabled then
                            if not hl then hl = Instance.new("Highlight"); hl.Name="XYLOESP"; hl.Parent=char end
                            hl.FillTransparency = Config.ESP.ChamsAlpha
                            hl.OutlineTransparency = 0
                            hl.FillColor = Config.ESP.RainbowESP and Color3.fromHSV(RainbowHue,1,1) or Color3.fromRGB(220,220,225)
                            hl.OutlineColor = Color3.fromRGB(255,255,255)
                        else
                            if hl then hl:Destroy() end
                        end

                        if Config.ESP.Chams then
                            if not char:FindFirstChild("XYLOChams") then
                                local tag = Instance.new("BoolValue"); tag.Name="XYLOChams"; tag.Parent=char
                            end
                            for _,p in ipairs(char:GetDescendants()) do
                                if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                                    p.Material = Enum.Material.Neon
                                    p.Color = Config.ESP.RainbowESP and Color3.fromHSV(RainbowHue,1,1) or Color3.fromRGB(220,220,225)
                                    p.Transparency = Config.ESP.ChamsAlpha
                                end
                            end
                        else
                            local ct = char:FindFirstChild("XYLOChams")
                            if ct then
                                ct:Destroy()
                                for _,p in ipairs(char:GetDescendants()) do
                                    if p:IsA("BasePart") then p.Material = Enum.Material.Plastic end
                                end
                            end
                        end

                        if DrawingsOK then
                            local uid = player.UserId
                            local e = getOrCreateESP(uid)
                            local head = char:FindFirstChild("Head")
                            local headPos, headOnScreen = head and currentCamera:WorldToViewportPoint(head.Position)
                            local hrpPos, hrpOnScreen = currentCamera:WorldToViewportPoint(hrp.Position)

                            if not hrpOnScreen then hideESP(uid) else
                                local top = headPos and Vector2.new(headPos.X, headPos.Y-16) or Vector2.new(hrpPos.X, hrpPos.Y-32)
                                local bottom = Vector2.new(hrpPos.X, hrpPos.Y+14)
                                local height = math.abs(top.Y-bottom.Y)
                                local width = height*0.55
                                local boxPos = Vector2.new(hrpPos.X-width*0.5, top.Y)
                                local col = Config.ESP.RainbowESP and Color3.fromHSV(RainbowHue,1,1) or Color3.fromRGB(220,220,225)

                                if e.box then
                                    e.box.Visible = Config.ESP.Box
                                    e.box.Position = boxPos; e.box.Size = Vector2.new(width, height)
                                    e.box.Color = col; e.box.Thickness = 1
                                end

                                if e.headDot and headPos and headOnScreen then
                                    e.headDot.Visible = Config.ESP.HeadDot
                                    e.headDot.Position = Vector2.new(headPos.X, headPos.Y)
                                    e.headDot.Color = col; e.headDot.Radius = 3
                                elseif e.headDot then e.headDot.Visible = false end

                                if Config.ESP.Skeleton then
                                    local joints = getSkeletonJoints(char)
                                    for ji, joint in ipairs(joints) do
                                        local p1 = char:FindFirstChild(joint[1]); local p2 = char:FindFirstChild(joint[2])
                                        if p1 and p2 and p1:IsA("BasePart") and p2:IsA("BasePart") then
                                            local sp1, s1on = currentCamera:WorldToViewportPoint(p1.Position)
                                            local sp2, s2on = currentCamera:WorldToViewportPoint(p2.Position)
                                            if s1on and s2on then
                                                if not e.skeleton[ji] then e.skeleton[ji] = newDrawing("Line"); e.skeleton[ji].Thickness=1.2 end
                                                e.skeleton[ji].Visible = true
                                                e.skeleton[ji].From = Vector2.new(sp1.X, sp1.Y)
                                                e.skeleton[ji].To = Vector2.new(sp2.X, sp2.Y)
                                                e.skeleton[ji].Color = col
                                            elseif e.skeleton[ji] then e.skeleton[ji].Visible = false end
                                        end
                                    end
                                else
                                    for k,l in pairs(e.skeleton) do pcall(function() l:Remove() end); e.skeleton[k]=nil end
                                end
                            end
                        end

                        local bb = char:FindFirstChild("XYLONameTag")
                        if Config.ESP.NameTags or Config.ESP.HealthBar or Config.ESP.Distance then
                            if not bb then
                                bb = Instance.new("BillboardGui"); bb.Name="XYLONameTag"; bb.Size=UDim2.new(0,160,0,52); bb.StudsOffset=Vector3.new(0,3.6,0); bb.Adornee=hrp; bb.AlwaysOnTop=true; bb.Parent=char
                            end
                            for _,c in ipairs(bb:GetChildren()) do c:Destroy() end
                            local yOff = 0
                            if Config.ESP.NameTags then local nl=Instance.new("TextLabel"); nl.Size=UDim2.new(1,0,0,16); nl.Position=UDim2.new(0,0,0,yOff); nl.BackgroundTransparency=1; nl.TextColor3=Color3.fromRGB(255,255,255); nl.TextStrokeTransparency=0; nl.Font=Enum.Font.GothamBold; nl.TextSize=13; nl.Text=player.Name; nl.Parent=bb; yOff=yOff+18 end
                            if Config.ESP.Distance then
                                local myHRP = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                                if myHRP then
                                    local d = math.floor((hrp.Position-myHRP.Position).Magnitude)
                                    local dl = Instance.new("TextLabel"); dl.Size=UDim2.new(1,0,0,12); dl.Position=UDim2.new(0,0,0,yOff); dl.BackgroundTransparency=1; dl.TextColor3=Color3.fromRGB(180,180,180); dl.TextStrokeTransparency=0; dl.Font=Enum.Font.Gotham; dl.TextSize=10; dl.Text=d.."m"; dl.Parent=bb; yOff=yOff+14
                                end
                            end
                            if Config.ESP.HealthBar then
                                local bg=Instance.new("Frame"); bg.Size=UDim2.new(1,0,0,5); bg.Position=UDim2.new(0,0,0,yOff); bg.BackgroundColor3=Color3.fromRGB(20,20,20); bg.BorderSizePixel=0; bg.Parent=bb; Instance.new("UICorner",bg).CornerRadius=UDim.new(1,0)
                                local hpPct=hum.Health/hum.MaxHealth
                                local hpBar=Instance.new("Frame"); hpBar.Size=UDim2.new(hpPct,0,1,0); hpBar.BackgroundColor3=Color3.fromRGB(math.floor(255*(1-hpPct)),math.floor(255*hpPct),0); hpBar.BorderSizePixel=0; hpBar.Parent=bg; Instance.new("UICorner",hpBar).CornerRadius=UDim.new(1,0)
                            end
                        else
                            if bb then bb:Destroy() end
                        end

                        if Config.ESP.Tracers and pi <= MAX_TRACERS then
                            local pos, onScreen = currentCamera:WorldToViewportPoint(hrp.Position)
                            if onScreen then
                                if not TracerLines[pi] then TracerLines[pi] = newDrawing("Line"); TracerLines[pi].Thickness=1; TracerLines[pi].Transparency=0.7 end
                                TracerLines[pi].Visible = true
                                TracerLines[pi].Color = Config.ESP.RainbowESP and Color3.fromHSV(RainbowHue,1,1) or Color3.fromRGB(220,220,225)
                                TracerLines[pi].From = tracerCenter
                                TracerLines[pi].To = Vector2.new(pos.X, pos.Y)
                                pi = pi + 1
                            end
                        end
                    end
                else
                    resetPlayerParts(player)
                    if ESPObjects[player.UserId] then hideESP(player.UserId) end
                end
            end
        end
    end

    for i = pi, #TracerLines do
        if TracerLines[i] then TracerLines[i].Visible = false end
    end
    if not Config.ESP.Tracers then
        for _,l in ipairs(TracerLines) do if l then l.Visible = false end end
    end

    -- FPS HUD VISIBILITY
    if fpsState.frame and fpsState.enabled then
        if frame.Visible then
            fpsState.frame.Visible = false
        else
            fpsState.frame.Visible = true
        end
    end

    -- UI scale popup check
    if uiChangedByUser then
        local broken = tbl3.UIScale <= 0.35 or tbl3.UIScale >= 1.65
        if broken and not popupOpen then
            popup.Visible = true; popupOpen = true; autoResetTimer = 3
            pDesc.Text = "Auto-resetting in 3s..."
        end
        if popupOpen then
            autoResetTimer = autoResetTimer - dt
            pDesc.Text = "Auto-resetting in " .. math.max(0, math.ceil(autoResetTimer)) .. "s..."
            if autoResetTimer <= 0 then doReset() end
        end
        if not broken and popupOpen then
            popup.Visible = false; popupOpen = false; autoResetTimer = 0
        end
    else
        popup.Visible = false; popupOpen = false; autoResetTimer = 0
    end
end)

