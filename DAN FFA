local ESPObjects = {}
local function hideESP(uid)
    local e=ESPObjects[uid]; if not e then return end
    if e.highlight then e.highlight:Destroy() end
    if e.box then e.box:Remove() end
    if e.headDot then e.headDot:Remove() end
    if e.tracer then e.tracer:Remove() end
    if e.healthBarBg then e.healthBarBg:Remove() end
    if e.healthBarFill then e.healthBarFill:Remove() end
    if e.nameTag then e.nameTag:Remove() end
    if e.distTag then e.distTag:Remove() end
    for _,l in ipairs(e.corners) do pcall(function() l:Remove() end) end
    for _,l in pairs(e.skeleton) do pcall(function() l:Remove() end) end
    ESPObjects[uid]=nil
end

