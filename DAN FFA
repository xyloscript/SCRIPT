local function isEnemy(arg)
    if not localPlayer or arg==localPlayer then return false end
    if not tbl3.TeamCheck then return true end
    if not arg.Character then return false end
    if arg:GetAttribute("Downed") == true or arg:GetAttribute("IsDowned") == true then return false end
    local a1=localPlayer:GetAttribute("StageTeamSide"); local a2=arg:GetAttribute("StageTeamSide")
    if typeof(a1)=="number" and typeof(a2)=="number" then return a1~=a2 end
    if localPlayer.Neutral or arg.Neutral then return true end
    local v,v2
    pcall(function() v=localPlayer.Team and localPlayer.Team.Name end)
    pcall(function() v2=arg.Team and arg.Team.Name end)
    if not v or not v2 then return true end
    return v~=v2
end

-- KILL CHECK: skip low-HP targets (0-10 by default) so silent aim doesn't finish/detect them
local function killCheckPass(character)
    if not tbl3.KillCheck then return true end
    if not character then return false end
    local hum = character:FindFirstChildOfClass("Humanoid")
    if not hum then return true end
    local hp = hum.Health
    if hp <= 0 then return false end
    if hp >= tbl3.KillCheckMin and hp <= tbl3.KillCheckMax then return false end
    return true
end

index._purge=function(arg,arg2)
    arg.targets[arg2]=nil
    local v=arg.charDeathConns[arg2]
    if v then for _,v2 in ipairs(v) do if v2.Connected then v2:Disconnect() end end; arg.charDeathConns[arg2]=nil end
end
index._bindCharDeath=function(arg,arg2)
    arg:_purge(arg2); local character=arg2.Character; if not character then return end
    local tbl6={}; arg.charDeathConns[arg2]=tbl6
    local function fn3() arg:_purge(arg2) end
    local h=character:FindFirstChildOfClass("Humanoid")
    if h then table.insert(tbl6,h.Died:Connect(fn3)) end
    table.insert(tbl6,character.AncestryChanged:Connect(function(_,p) if not p then fn3() end end))
end
index._refresh=function(arg,arg2)
    if arg2 and arg2~=localPlayer and arg2.Parent then
        local c=arg2.Character
        if c and c.Parent then
            local h=c:FindFirstChildOfClass("Humanoid"); local hrp=c:FindFirstChild("HumanoidRootPart")
            if h and hrp and h.Health>0 then arg.targets[arg2]={player=arg2,character=c,humanoid=h,hrp=hrp}; return end
            arg:_purge(arg2); return
        end
        arg.targets[arg2]=nil; return
    end
    arg:_purge(arg2)
end
index._bindPlayer=function(arg,arg2)
    if arg.connections[arg2] then return end
    local tbl6={}; arg.connections[arg2]=tbl6
    table.insert(tbl6,arg2.CharacterAdded:Connect(function() arg:_bindCharDeath(arg2); arg:_refresh(arg2) end))
    table.insert(tbl6,arg2.CharacterRemoving:Connect(function() arg:_purge(arg2) end))
    table.insert(tbl6,arg2:GetPropertyChangedSignal("Team"):Connect(function() arg:_refresh(arg2) end))
    arg:_bindCharDeath(arg2); arg:_refresh(arg2)
end
index.start=function(arg)
    for _,p in ipairs(Players:GetPlayers()) do if p~=localPlayer then arg:_bindPlayer(p) end end
    table.insert(arg.connections,Players.PlayerAdded:Connect(function(p) if p~=localPlayer then arg:_bindPlayer(p) end end))
    table.insert(arg.connections,Players.PlayerRemoving:Connect(function(p)
        arg:_purge(p); local v=arg.connections[p]
        if v then for _,v2 in ipairs(v) do if v2.Connected then v2:Disconnect() end end; arg.connections[p]=nil end
    end))
end
index.getList=function(arg)
    local tbl6={}
    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer then
            local char = p.Character
            local h = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if h and hrp and h.Health > 0 then
                arg.targets[p] = {player=p, character=char, humanoid=h, hrp=hrp}
            else arg.targets[p] = nil end
        end
    end
    for k,t in pairs(arg.targets) do
        if t.hrp and t.hrp.Parent and t.humanoid and t.humanoid.Parent and t.humanoid.Health>0 then
            table.insert(tbl6,t)
        else arg.targets[k]=nil end
    end
    return tbl6
end
