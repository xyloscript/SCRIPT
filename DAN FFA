local function withinDist(pos)
    if tbl3.MaxDist==0 then return true end
    local c=localPlayer.Character; local hrp=c and c:FindFirstChild("HumanoidRootPart")
    if not hrp then return true end
    return (pos-hrp.Position).Magnitude<=tbl3.MaxDist
end
local function targetPartOf(arg)
    local c=arg.character; if not c or not c.Parent then return nil end
    return c:FindFirstChild(tbl3.BodyPart) or arg.hrp
end

local lastTargetScan = 0
local cachedTarget = nil
local function scanTarget()
    local now = os.clock()
    if now - lastTargetScan < 0.05 then return cachedTarget end
    lastTargetScan = now
    local center = currentCamera.ViewportSize / 2
    local vec=Vector2.new(center.X, center.Y); local fov=tbl3.FOV; local v2=nil
    for _,v3 in ipairs(v:getList()) do
        if isEnemy(v3.player) and killCheckPass(v3.character) then
            local hrp=v3.hrp
            if hrp and hrp.Parent and withinDist(hrp.Position) then
                local v4=targetPartOf(v3)
                if v4 then
                    local v5,v6=currentCamera:WorldToViewportPoint(v4.Position)
                    if v6 then
                        local mag=(Vector2.new(v5.X,v5.Y)-vec).Magnitude
                        if mag<fov then fov=mag; v2=v3 end
                    end
                end
            end
        end
    end
    cachedTarget = v2
    return v2
end

local function getValidTarget(arg)
    if not arg then return nil,nil end
    local c=arg.character; if not c or not c.Parent then return nil,nil end
    local h=arg.humanoid; if not h or not h.Parent or h.Health<=1 then return nil,nil end
    if not killCheckPass(c) then return nil,nil end
    local v2=targetPartOf(arg); if v2 and withinDist(v2.Position) then return v2,h end
    return nil,nil
end

local cachedTargetPart = nil

RunService.RenderStepped:Connect(function()
    if tbl3.Enabled or tbl3.Triggerbot then
        local best = scanTarget()
        if best and best.humanoid and best.humanoid.Health > 0 then
            local part = getValidTarget(best)
            cachedTargetPart = part
        else cachedTargetPart = nil end
    else cachedTargetPart = nil end
end)

-- ── NO SPREAD / NO DELAY / INFINITE STUDS HOOKS ──
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    -- SILENT AIM redirect
    if tbl3.Enabled and cachedTargetPart and cachedTargetPart.Parent then
        if method == "Raycast" or method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" then
            local origin, direction
            if method == "Raycast" then origin, direction = args[1], args[2]
            else
                local ray = args[1]
                if typeof(ray) == "Ray" then origin, direction = ray.Origin, ray.Direction end
            end
            if typeof(origin) == "Vector3" and typeof(direction) == "Vector3" then
                local toTarget = cachedTargetPart.Position - origin
                local newMag = math.max(direction.Magnitude, toTarget.Magnitude + 5)
                if method == "Raycast" then args[2] = toTarget.Unit * newMag
                else args[1] = Ray.new(origin, toTarget.Unit * newMag) end
                return oldNamecall(self, table.unpack(args))
            end
        end
    end

    -- NO SPREAD: force spread = 0 on shoot calls
    if tbl3.NoSpread then
        if method == "Fire" or method == "Shoot" or method == "FireWeapon" or method == "BulletFire" then
            for i, a in ipairs(args) do
                if typeof(a) == "number" and (i <= 4) then
                    -- spread arg position varies; clamp small spread values
                    if a > 0 and a < 5 then args[i] = 0 end
                elseif typeof(a) == "Vector3" and a.Magnitude < 5 then
                    args[i] = Vector3.zero
                end
            end
            return oldNamecall(self, table.unpack(args))
        end
    end

    -- INFINITE STUDS: extend bullet ray/range
    if tbl3.InfiniteStuds then
        if method == "Raycast" or method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" then
            local origin, direction
            if method == "Raycast" then origin, direction = args[1], args[2]
            else
                local ray = args[1]
                if typeof(ray) == "Ray" then origin, direction = ray.Origin, ray.Direction end
            end
            if typeof(origin) == "Vector3" and typeof(direction) == "Vector3" then
                local extended = direction.Unit * 999999
                if method == "Raycast" then args[2] = extended
                else args[1] = Ray.new(origin, extended) end
                return oldNamecall(self, table.unpack(args))
            end
        end
    end

    return oldNamecall(self, ...)
end)

