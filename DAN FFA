    local cList = Instance.new("UIListLayout", container); cList.Padding = UDim.new(0,2); cList.SortOrder = Enum.SortOrder.LayoutOrder
    local cPadding = Instance.new("UIPadding", container); cPadding.PaddingTop = UDim.new(0,4); cPadding.PaddingBottom = UDim.new(0,4); cPadding.PaddingLeft = UDim.new(0,4); cPadding.PaddingRight = UDim.new(0,4)
    for i, opt in ipairs(options) do
        local optBtn = Instance.new("TextButton", container)
        optBtn.Size = UDim2.new(1,0,0,24); optBtn.BackgroundColor3 = tbl5.bgRow
        optBtn.BorderSizePixel = 0; optBtn.Text = opt; optBtn.TextColor3 = tbl5.text; optBtn.TextSize = 12; optBtn.Font = Enum.Font.GothamMedium; optBtn.ZIndex = 1000; optBtn.LayoutOrder = i
        Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0,4)
        optBtn.MouseEnter:Connect(function() TweenService:Create(optBtn, TweenInfo.new(0.1), {BackgroundColor3 = tbl5.bgRowHi}):Play() end)
        optBtn.MouseLeave:Connect(function() TweenService:Create(optBtn, TweenInfo.new(0.1), {BackgroundColor3 = tbl5.bgRow}):Play() end)
        optBtn.MouseButton1Click:Connect(function() btn.Text = opt; cb(opt); container.Visible = false end)
    end
    local isOpen = false
    btn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        if isOpen then
            local absPos = btn.AbsolutePosition; local absSize = btn.AbsoluteSize
            local frameAbsPos = frame.AbsolutePosition
            container.Position = UDim2.fromOffset(absPos.X - frameAbsPos.X, absPos.Y - frameAbsPos.Y + absSize.Y + 4)
            container.Size = UDim2.new(0, btn.AbsoluteSize.X, 0, math.min(#options * 26 + 8, 160))
            container.Visible = true
        else container.Visible = false end
    end)
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            container.Visible = false; isOpen = false
        end
    end)
    UserInputService.InputBegan:Connect(function(input, gp)
        if not gp and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            if isOpen then
                local mPos = Vector2.new(input.Position.X, input.Position.Y)
                local cPos = container.AbsolutePosition; local cSize = container.AbsoluteSize
                if not (mPos.X >= cPos.X and mPos.X <= cPos.X + cSize.X and mPos.Y >= cPos.Y and mPos.Y <= cPos.Y + cSize.Y) then
                    isOpen = false; container.Visible = false
                end
            end
        end
    end)
    row.MouseEnter:Connect(function() TweenService:Create(row, TweenInfo.new(0.12), {BackgroundColor3 = tbl5.bgRowHi}):Play() end)
    row.MouseLeave:Connect(function() TweenService:Create(row, TweenInfo.new(0.12), {BackgroundColor3 = tbl5.bgRow}):Play() end)
    return row
end

