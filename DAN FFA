local fpsState = { enabled = true, frame = nil, label = nil, elapsed = 0, frames = 0, conn = nil }
local function getPing()
    local ping = 0
    pcall(function() ping = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()) end)
    return ping
end
local function fpsDestroy()
    if fpsState.conn then fpsState.conn:Disconnect(); fpsState.conn = nil end
    if fpsState.frame then fpsState.frame:Destroy(); fpsState.frame = nil; fpsState.label = nil end
    fpsState.elapsed = 0; fpsState.frames = 0
end
local function fpsEnable(parentGui)
    fpsDestroy()
    local frame = Instance.new("Frame")
    frame.Name = "DANFFA_HUD"
    frame.AnchorPoint = Vector2.new(0.5, 0)
    frame.Position = UDim2.new(0.5, 0, 0, 8)
    frame.Size = UDim2.fromOffset(210, 24) 
    frame.BackgroundColor3 = Color3.fromRGB(42, 52, 65)
    frame.BackgroundTransparency = 0.15
    frame.BorderSizePixel = 0
    frame.ZIndex = 100
    frame.Parent = parentGui
    frame.Visible = false
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.fromRGB(100, 100, 100)
    stroke.Thickness = 1
    stroke.Transparency = 0.5
    local value = Instance.new("TextLabel", frame)
    value.Size = UDim2.new(1, -16, 1, 0)
    value.Position = UDim2.new(0, 8, 0, 0)
    value.BackgroundTransparency = 1
    value.Text = "DAN FFA PREMIUM | -- FPS | --ms"
    value.TextColor3 = Color3.fromRGB(255, 255, 255)
    value.TextSize = 12
    value.Font = Enum.Font.GothamBold
    value.TextXAlignment = Enum.TextXAlignment.Center
    value.ZIndex = 101
    fpsState.frame = frame
    fpsState.label = value
    fpsState.conn = RunService.RenderStepped:Connect(function(dt)
        if not fpsState.enabled or not fpsState.label then return end
        if dt > 0 then fpsState.elapsed = fpsState.elapsed + dt; fpsState.frames = fpsState.frames + 1 end
        if fpsState.elapsed >= 1 then
            local fps = math.floor(fpsState.frames / fpsState.elapsed + 0.5)
            local ping = getPing()
            fpsState.label.Text = string.format("DAN FFA PREMIUM | %d FPS | %dms", fps, ping)
            fpsState.elapsed = 0; fpsState.frames = 0
        end
    end)
end
local function fpsSetEnabled(enabled, parentGui)
    fpsState.enabled = enabled
    if enabled then fpsEnable(parentGui) else fpsDestroy() end
end

