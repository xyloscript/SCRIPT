    e.box.Thickness=1; e.box.Filled=false; e.box.Visible=false
    e.headDot.Filled=true; e.headDot.Radius=3; e.headDot.Visible=false
    e.tracer.Thickness=1; e.tracer.Transparency=0.7; e.tracer.Visible=false
    return e
