local function createESP(uid)
    if ESPObjects[uid] then return ESPObjects[uid] end
    local corners={}
    for i=1,8 do local l=Drawing.new("Line"); l.Thickness=2; l.Visible=false; table.insert(corners,l) end
    local hBg = Drawing.new("Square"); hBg.Thickness=1; hBg.Filled=true; hBg.Visible=false
    local hFill = Drawing.new("Square"); hFill.Thickness=1; hFill.Filled=true; hFill.Visible=false
    local nt = Drawing.new("Text"); nt.Size=14; nt.Center=true; nt.Outline=true; nt.Visible=false; nt.Font=2
    local dt = Drawing.new("Text"); dt.Size=12; dt.Center=true; dt.Outline=true; dt.Visible=false; dt.Font=2
    ESPObjects[uid]={ box=Drawing.new("Square"), corners=corners, skeleton={}, headDot=Drawing.new("Circle"), tracer=Drawing.new("Line"), healthBarBg=hBg, healthBarFill=hFill, nameTag=nt, distTag=dt, highlight=nil }
