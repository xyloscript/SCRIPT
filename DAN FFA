local function applyToolChanges(tool)
    if not tool or not tool:IsA("Tool") then return end
    if tbl3.RapidFire then
        for _, attr in ipairs({"RateOfFire","rateOfFire","FireRate","fireRate","Cooldown"}) do
            if tool:GetAttribute(attr) ~= nil then
                if attr == "Cooldown" then tool:SetAttribute(attr, 1/tbl3.RateOfFire)
                else tool:SetAttribute(attr, tbl3.RateOfFire) end
            end
        end
    end
    if tbl3.DamageChanger then
        for _, attr in ipairs({"Damage","damage","Dmg","dmg","Power"}) do
            if tool:GetAttribute(attr) ~= nil then tool:SetAttribute(attr, tbl3.DamageValue) end
        end
    end
    -- NO DELAY / INFINITE STUDS / NO SPREAD via attributes
    if tbl3.NoDelay then
        for _, attr in ipairs({"FireDelay","Delay","Cooldown","ShootDelay","ReloadTime"}) do
            if tool:GetAttribute(attr) ~= nil then tool:SetAttribute(attr, 0) end
        end
    end
    if tbl3.NoSpread then
        for _, attr in ipairs({"Spread","spread","BulletSpread","Accuracy"}) do
            if tool:GetAttribute(attr) ~= nil then tool:SetAttribute(attr, 0) end
        end
    end
    if tbl3.InfiniteStuds then
        for _, attr in ipairs({"Range","range","BulletRange","Studs","StudDistance","MaxRange"}) do
            if tool:GetAttribute(attr) ~= nil then tool:SetAttribute(attr, 999999) end
        end
    end
    for _, v in ipairs(tool:GetDescendants()) do
        if v:IsA("NumberValue") or v:IsA("IntValue") then
            local name = v.Name:lower()
            if tbl3.RapidFire and (name:find("rate") or name:find("fire") or name:find("cooldown") or name:find("delay")) then
                v.Value = tbl3.RateOfFire
            end
            if tbl3.DamageChanger and (name:find("damage") or name:find("dmg") or name:find("power")) then
                v.Value = tbl3.DamageValue
            end
            if tbl3.NoDelay and (name:find("delay") or name:find("cooldown") or name:find("reload")) then
                v.Value = 0
            end
            if tbl3.NoSpread and (name:find("spread") or name:find("accuracy")) then
                v.Value = 0
            end
            if tbl3.InfiniteStuds and (name:find("range") or name:find("studs") or name:find("distance")) then
                v.Value = 999999
            end
        end
    end
end

