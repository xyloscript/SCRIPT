local function updateFOV()
    local center = currentCamera.ViewportSize / 2
    if tbl3.ShowFOV and tbl3.FOVMode == 3 then
        fovCircleImg.Visible = true
        fovCircleImg.Position = UDim2.fromOffset(center.X, center.Y)
        fovCircleImg.Size = UDim2.fromOffset(tbl3.FOV * 2, tbl3.FOV * 2)
        for _, l in ipairs(fovLines) do l.Visible = false end
    elseif tbl3.ShowFOV and tbl3.FOVMode == 1 then
        fovCircleImg.Visible = false
        local r = tbl3.FOV
        for i = 1, fovSegments do
            local a1 = (i - 1) / fovSegments * math.pi * 2
            local a2 = i / fovSegments * math.pi * 2
            fovLines[i].From = Vector2.new(center.X + math.cos(a1) * r, center.Y + math.sin(a1) * r)
            fovLines[i].To = Vector2.new(center.X + math.cos(a2) * r, center.Y + math.sin(a2) * r)
            fovLines[i].Visible = true
        end
    elseif tbl3.ShowFOV and tbl3.FOVMode == 2 then
        fovCircleImg.Visible = false
        local rx = tbl3.FOV; local ry = tbl3.FOV * 0.6
        for i = 1, fovSegments do
            local a1 = (i - 1) / fovSegments * math.pi * 2
            local a2 = i / fovSegments * math.pi * 2
            fovLines[i].From = Vector2.new(center.X + math.cos(a1) * rx, center.Y + math.sin(a1) * ry)
            fovLines[i].To = Vector2.new(center.X + math.cos(a2) * rx, center.Y + math.sin(a2) * ry)
            fovLines[i].Visible = true
        end
    else
        fovCircleImg.Visible = false
        for _, l in ipairs(fovLines) do l.Visible = false end
    end

    if tbl3.AimAssistEnabled and tbl3.AimAssistShowFOV then
        local r = tbl3.AimAssistFOV
        for i = 1, fovSegments do
            local a1 = (i - 1) / fovSegments * math.pi * 2
            local a2 = i / fovSegments * math.pi * 2
            aaFovLines[i].From = Vector2.new(center.X + math.cos(a1) * r, center.Y + math.sin(a1) * r)
            aaFovLines[i].To = Vector2.new(center.X + math.cos(a2) * r, center.Y + math.sin(a2) * r)
            aaFovLines[i].Color = aimAssistLocked and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(120, 200, 255)
            aaFovLines[i].Visible = true
        end
    else
        for _, l in ipairs(aaFovLines) do l.Visible = false end
    end

    if tbl3.Triggerbot and tbl3.TriggerbotFOVVisible then
        triggerbotFOVGui.Visible = true
        triggerbotFOVGui.Position = UDim2.fromOffset(center.X, center.Y)
        triggerbotFOVGui.Size = UDim2.fromOffset(tbl3.TriggerbotFOV * 2, tbl3.TriggerbotFOV * 2)
        local hasTarget = getTarget(tbl3.TriggerbotFOV) ~= nil
        triggerbotFOVStroke.Color = hasTarget and tbl3.TriggerbotFOVTargetColor or tbl3.TriggerbotFOVColor
        triggerbotFOVStroke.Transparency = 1 - math.clamp(tbl3.TriggerbotFOVTransparency, 0, 1)
    else
        triggerbotFOVGui.Visible = false
    end
end

