local espTick = 0
local espInterval = 0.08
local indicatorTick = 0
local indicatorInterval = 0.03

RunService.RenderStepped:Connect(function(dt)
    espTick = espTick + dt
    indicatorTick = indicatorTick + dt
    aimAssistApply(dt)

    if tbl3.Enabled then sa2UpdateTarget() end

    -- FPS HUD Visibility Logic
    if fpsState.frame and fpsState.enabled then
        if frame.Visible then
            fpsState.frame.Visible = false
        else
            fpsState.frame.Visible = true
        end
    end

    if tbl3.CameraTPActive then
        local char = localPlayer.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local camera = Workspace.CurrentCamera
        if not humanoid or not root or not camera then stopCameraTP(true) else
            root.Anchored = true
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            humanoid.AutoRotate = false
            local cameraPosition = camera.CFrame.Position
            local rotation = CFrame.Angles(0, CameraTPYaw, 0) * CFrame.Angles(CameraTPPitch, 0, 0)
            camera.CFrame = CFrame.new(cameraPosition) * rotation
            local moveDir = humanoid.MoveDirection
            if moveDir.Magnitude > 0.001 then
                local look = camera.CFrame.LookVector
                local right = camera.CFrame.RightVector
                local flatRight = Vector3.new(right.X, 0, right.Z)
                if flatRight.Magnitude > 0.001 then flatRight = flatRight.Unit else flatRight = Vector3.new(1, 0, 0) end
                local flatForward = Vector3.new(look.X, 0, look.Z)
                if flatForward.Magnitude > 0.001 then flatForward = flatForward.Unit else flatForward = Vector3.new(0, 0, -1) end
                local forwardInput = moveDir:Dot(flatForward)
                local strafeInput = moveDir:Dot(flatRight)
                local flyDirection = flatRight * strafeInput + look * forwardInput
                if flyDirection.Magnitude > 0.001 then
                    flyDirection = flyDirection.Unit
                    camera.CFrame = camera.CFrame + flyDirection * math.max(tbl3.CameraTPSpeed, 1) * dt
                end
            end
        end
    end

    if indicatorTick >= indicatorInterval then
        updateFOV()
        if tbl3.ShowTargetIndicator and SA2.targetPart then
            local v13,v14 = currentCamera:WorldToViewportPoint(SA2.targetPart.Position)
            if v14 then
                local vec = Vector2.new(v13.X, v13.Y)
                line.Visible = true; line.From = Vector2.new(currentCamera.ViewportSize.X/2, currentCamera.ViewportSize.Y); line.To = vec
                tdot.Visible = true; tdot.Position = UDim2.new(0,vec.X,0,vec.Y)
            else
                line.Visible = false; tdot.Visible = false
            end
        else
            line.Visible = false; tdot.Visible = false
        end
        if tbl3.Triggerbot then
            local target = getTarget(tbl3.TriggerbotFOV)
            if target then
                if TriggerbotLastTarget ~= target then
                    TriggerbotLastTarget = target
                    TriggerbotFirstSeen = os.clock()
                else
                    local held = os.clock() - TriggerbotFirstSeen
                    local smoothDelay = (tbl3.TriggerbotSmoothness or 0) / 200
                    if held >= smoothDelay then triggerbotShoot() end
                end
            else
                TriggerbotLastTarget = nil
                TriggerbotFirstSeen = 0
            end
        else
            TriggerbotLastTarget = nil
            TriggerbotFirstSeen = 0
        end
        indicatorTick = 0
    end

    if uiChangedByUser then
        local broken = tbl3.UIScale <= 0.35 or tbl3.UIScale >= 1.65
        if broken and not popupOpen then
            popup.Visible = true; popupOpen = true; autoResetTimer = 3
            pDesc.Text = "Auto-resetting in 3s..."
        end
        if popupOpen then
            autoResetTimer = autoResetTimer - dt
            pDesc.Text = "Auto-resetting in " .. math.max(0, math.ceil(autoResetTimer)) .. "s..."
            if autoResetTimer <= 0 then doReset() end
        end
        if not broken and popupOpen then
            popup.Visible = false; popupOpen = false; autoResetTimer = 0
        end
    else
        popup.Visible = false; popupOpen = false; autoResetTimer = 0
    end

    if espTick >= espInterval then
        if not tbl3.ESPEnabled and not tbl3.BoxESP and not tbl3.CornerBoxESP and not tbl3.SkeletonESP and not tbl3.NameTags and not tbl3.HealthBar and not tbl3.DistanceESP and not tbl3.HeadDot and not tbl3.Tracers then
            for uid, e in pairs(ESPObjects) do hideESP(uid) end
        else
            local myHRP = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
            local activeUids = {}
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= localPlayer then
                    local char = player.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if hum and hum.Health > 0 and hrp and myHRP and (hrp.Position - myHRP.Position).Magnitude <= tbl3.ESPDist then
                        local uid = player.UserId
                        activeUids[uid] = true
                        local e = createESP(uid)
                        local pos, onScreen = currentCamera:WorldToViewportPoint(hrp.Position)
                        local head = char:FindFirstChild("Head")
                        if head and onScreen then
                            local headPos, headOnScreen = currentCamera:WorldToViewportPoint(head.Position)
                            local top = headOnScreen and Vector2.new(headPos.X, headPos.Y - 16) or Vector2.new(pos.X, pos.Y - 32)
                            local bottom = Vector2.new(pos.X, pos.Y + 14)
                            local height = math.abs(top.Y - bottom.Y)
                            local width = height * 0.55
                            local boxPos = Vector2.new(pos.X - width*0.5, top.Y)
                            local col = tbl3.ESPColor
                            if tbl3.BoxESP then e.box.Visible = true; e.box.Position = boxPos; e.box.Size = Vector2.new(width, height); e.box.Color = col; e.box.Transparency = 1
                            else e.box.Visible = false end
                            if tbl3.CornerBoxESP then
                                local cw = width*0.28; local ch = height*0.22
                                local corners = { {boxPos,Vector2.new(1,0),Vector2.new(0,1)}, {boxPos+Vector2.new(width,0),Vector2.new(-1,0),Vector2.new(0,1)}, {boxPos+Vector2.new(0,height),Vector2.new(1,0),Vector2.new(0,-1)}, {boxPos+Vector2.new(width,height),Vector2.new(-1,0),Vector2.new(0,-1)} }
                                for ci, corner in ipairs(corners) do
                                    local idx1 = (ci-1)*2+1; local idx2 = idx1+1
                                    e.corners[idx1].Visible = true; e.corners[idx1].From = corner[1]; e.corners[idx1].To = corner[1]+corner[2]*cw; e.corners[idx1].Color = col; e.corners[idx1].Transparency = 1
                                    e.corners[idx2].Visible = true; e.corners[idx2].From = corner[1]; e.corners[idx2].To = corner[1]+corner[3]*ch; e.corners[idx2].Color = col; e.corners[idx2].Transparency = 1
                                end
                            else for _,l in ipairs(e.corners) do l.Visible = false end end
                            if tbl3.SkeletonESP then
                                local joints = getSkeletonJoints(char)
                                for ji, joint in ipairs(joints) do
