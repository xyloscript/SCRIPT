local RS = game:GetService("ReplicatedStorage")
local SA2 = { targetPart = nil, targetPlayer = nil }

local function sa2Chance(chance)
    chance = tonumber(chance) or 100
    if chance >= 100 then return true end
    if chance <= 0 then return false end
    return math.random(1, 100) <= chance
end

local function sa2Enemy(player)
    if not player or player == localPlayer then return false end
    if tbl3.SA2_TeamTarget == "All" then return true end
    if tbl3.SA2_TeamTarget == "Teams" then
        if localPlayer.Team and player.Team then return localPlayer.Team == player.Team end
        return false
    end
    if tbl3.TeamCheck then
        if localPlayer.Team and player.Team then 
            return localPlayer.Team ~= player.Team 
        end
        return true
    end
    return true
end

local function sa2Visible(character, part)
    if tbl3.SA2_Wallbang or tbl3.SilentWallbang then return true end 
    if not tbl3.SA2_Wallcheck and not tbl3.SilentWallCheck then return true end
    
    if not character or not part then return false end
    local camera = Workspace.CurrentCamera
    if not camera then return false end
    local origin = camera.CFrame.Position
    local direction = part.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { localPlayer.Character, character }
    params.IgnoreWater = true
    return Workspace:Raycast(origin, direction, params) == nil
end

local function sa2PredictedPosition(part)
    if not part or not part.Parent then return nil end
    local prediction = tonumber(tbl3.SA2_Prediction) or 0
    prediction = math.clamp(prediction, 0, 0.5)
    if prediction <= 0 then return part.Position end
    local velocity = Vector3.zero
    pcall(function() velocity = part.AssemblyLinearVelocity end)
    return part.Position + (velocity * prediction)
end

local function sa2FindTarget()
    if not tbl3.Enabled then return nil, nil end
    local camera = Workspace.CurrentCamera
    if not camera then return nil, nil end
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    local bestPlayer = nil
    local bestPart = nil
    local bestScore = math.huge
    local fovSq = (tonumber(tbl3.FOV) or 100) ^ 2
    local range = tonumber(tbl3.SA2_TargetRange) or 500
    local localCharacter = localPlayer.Character
    local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
    if not localRoot then return nil, nil end
    
    for _, target in ipairs(Players:GetPlayers()) do
        if sa2Enemy(target) then
            local character = target.Character
            local hum = character and character:FindFirstChildOfClass("Humanoid")
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp then
                local part = character:FindFirstChild(tbl3.BodyPart) or hrp
                local worldDistance = (part.Position - localRoot.Position).Magnitude
                
                if worldDistance <= range and sa2Visible(character, part) then
                    local screen, onScreen = camera:WorldToViewportPoint(part.Position)
                    local inFov = false
                    local screenDistance = math.huge
                    if tbl3.SA2_ThreeSixtyMode then
                        inFov = true
                    elseif onScreen and screen.Z > 0 then
                        local dx = screen.X - center.X
                        local dy = screen.Y - center.Y
                        screenDistance = dx * dx + dy * dy
                        inFov = screenDistance <= fovSq
                    end
                    
                    if inFov then
                        local score
                        if tbl3.SA2_GetTarget == "Lowest Health" then
                            score = hum.Health
                        else
                            score = tbl3.SA2_ThreeSixtyMode and worldDistance or screenDistance
                        end
                        if score < bestScore then
                            bestScore = score
                            bestPlayer = target
                            bestPart = part
                        end
                    end
                end
            end
        end
    end
    return bestPlayer, bestPart
end

local function sa2UpdateTarget()
    if not tbl3.Enabled then
        SA2.targetPlayer = nil
        SA2.targetPart = nil
        return
    end
    local playerTarget, partTarget = sa2FindTarget()
    SA2.targetPlayer = playerTarget
    SA2.targetPart = partTarget
end

local function sa2SetEnabled(enabled)
    tbl3.Enabled = enabled
    if enabled then
        if not getgenv().XyloBlasterHook then
            local success, getRayDirections = pcall(function()
                return require(RS:WaitForChild("Blaster"):WaitForChild("Utility"):WaitForChild("getRayDirections"))
            end)
            if success and type(getRayDirections) == "function" then
                if type(hookfunction) == "function" and type(newcclosure) == "function" then
                    local Hkiz
                    Hkiz = hookfunction(getRayDirections, newcclosure(function(originCFrame, count, spread, seed)
                        if not tbl3.Enabled then return Hkiz(originCFrame, count, spread, seed) end
                        if not SA2.targetPart or not SA2.targetPart.Parent then sa2UpdateTarget() end
                        
                        local targetPos = sa2PredictedPosition(SA2.targetPart)
                        if targetPos then
                            if not sa2Chance(tbl3.SA2_HitChance) then return Hkiz(originCFrame, count, spread, seed) end
                            
                            local origin = originCFrame.Position
                            
                            if tbl3.SA2_Wallbang or tbl3.SilentWallbang or tbl3.SA2_BulletTeleport or tbl3.SilentBulletTeleport then
                                local dist = (targetPos - origin).Magnitude
                                if dist > 2 then
                                    origin = targetPos - (targetPos - origin).Unit * 2
                                end
                                local dir = targetPos - origin
                                if dir.Magnitude > 0.001 then
                                    local unit = dir.Unit
                                    local out = table.create(count)
                                    for i = 1, count do out[i] = unit end
                                    return out
                                end
                            end
                            
                            local dir = targetPos - origin
                            if dir.Magnitude > 0.001 then
                                local unit = dir.Unit
                                local out = table.create(count)
                                for i = 1, count do out[i] = unit end
                                return out
                            end
                        end
                        return Hkiz(originCFrame, count, spread, seed)
                    end))
                    getgenv().XyloBlasterHook = true
                end
            end
        end
    else
        SA2.targetPlayer = nil
        SA2.targetPart = nil
    end
end

