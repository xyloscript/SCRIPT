-- ============================================================
local aimAssistTarget = nil
local aimAssistTargetPart = nil
local aimAssistLastScan = 0
local AIM_ASSIST_SCAN_INTERVAL = 0.04
local smoothAngle = nil
local aimAssistLocked = false

local losRayParams = RaycastParams.new()
losRayParams.FilterType = Enum.RaycastFilterType.Exclude
losRayParams.IgnoreWater = true

local function hasLineOfSight(targetModel)
    if not targetModel then return false end
    local char = localPlayer.Character
    if not char then return false end
    local myHRP = char:FindFirstChild("HumanoidRootPart")
    local cam = Workspace.CurrentCamera
    if not myHRP or not cam then return false end
    local origin = cam.CFrame.Position
    local targetPart = targetModel:FindFirstChild("Head") or targetModel:FindFirstChild("HumanoidRootPart")
        or targetModel:FindFirstChild("UpperTorso") or targetModel:FindFirstChild("Torso")
    if not targetPart then return false end
    local filter = {char}
    if targetModel:IsA("Model") then table.insert(filter, targetModel) end
    losRayParams.FilterDescendantsInstances = filter
    local dir = targetPart.Position - origin
    local dist = dir.Magnitude
    if dist < 0.1 then return true end
    return Workspace:Raycast(origin, dir.Unit * dist, losRayParams) == nil
end

local function aimAssistTeamOk(player)
    if not tbl3.TeamCheck then return true end
    if not player or player == localPlayer then return false end
    if localPlayer.Team and player.Team then return localPlayer.Team ~= player.Team end
    return true
end

local function aimAssistFindTarget()
    local now = os.clock()
    if now - aimAssistLastScan < AIM_ASSIST_SCAN_INTERVAL then return end
    aimAssistLastScan = now
    aimAssistTarget = nil; aimAssistTargetPart = nil
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    local bestDist = tbl3.AimAssistFOV
    local myChar = localPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    for _, target in ipairs(Players:GetPlayers()) do
        if aimAssistTeamOk(target) then
            local char = target.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp and myHRP then
                local dist3d = (hrp.Position - myHRP.Position).Magnitude
                if dist3d <= tbl3.AimAssistMaxDist then
                    local part = char:FindFirstChild(tbl3.BodyPart) or hrp
                    local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local mag = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if mag < bestDist then
                            local losOk = true
                            if tbl3.AimAssistWallCheck then losOk = hasLineOfSight(char) end
                            if losOk then
                                bestDist = mag
                                aimAssistTarget = target
                                aimAssistTargetPart = part
                            end
                        end
                    end
                end
            end
        end
    end
    aimAssistLocked = aimAssistTargetPart ~= nil
end

local function aimAssistApply(dt)
    if not tbl3.AimAssistEnabled then smoothAngle = nil; aimAssistLocked = false; return end
    local cam = Workspace.CurrentCamera
    if not cam then return end
    aimAssistFindTarget()
    if not aimAssistTargetPart or not aimAssistTarget then smoothAngle = nil; return end
    local targetPos = aimAssistTargetPart.Position
    local camPos = cam.CFrame.Position
    local desired = CFrame.lookAt(camPos, targetPos)
    if tbl3.AimAssistMode == "Smooth" then
        local s = math.clamp(1 - tbl3.AimAssistSmoothness, 0.05, 1)
        if not smoothAngle then smoothAngle = cam.CFrame end
        smoothAngle = smoothAngle:Lerp(desired, math.clamp(s * dt * 20, 0, 1))
        cam.CFrame = smoothAngle
    elseif tbl3.AimAssistMode == "Magnetism" then
        local blended = cam.CFrame:Lerp(desired, math.clamp(tbl3.AimAssistStrength * dt * 15, 0, 1))
        cam.CFrame = blended
        smoothAngle = nil
    end
end

