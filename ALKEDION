function PG.Enable()
    if PG.enabled then return end
    PG.enabled = true
    PG.generation = PG.generation + 1
    local rendering = settings().Rendering
    pcall(function()
        PG.quality = rendering.QualityLevel
        PG.meshDetail = rendering.MeshPartDetailLevel
    end)
    pcall(function() rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    pcall(function() rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01 end)
    pgOverride(Lighting, PG.lighting, PG_LightingTargets)
    pgOverride(Workspace.Terrain, PG.terrain, PG_TerrainTargets)
    PG.queue = {}
    PG.queueHead = 0
    for _, inst in ipairs(Lighting:GetDescendants()) do
        PG.queueHead = PG.queueHead + 1
        PG.queue[PG.queueHead] = inst
    end
    for _, inst in ipairs(Workspace:GetDescendants()) do
        PG.queueHead = PG.queueHead + 1
        PG.queue[PG.queueHead] = inst
    end
    PG.workerActive = true
    task.spawn(pgWorker, PG.generation)
    getgenv().__xyPG_Light = PG_LightingTargets
end

function PG.Disable()
    if not PG.enabled then return end
    PG.enabled = false
    PG.generation = PG.generation + 1
    pcall(function()
        local rendering = settings().Rendering
        if PG.quality then rendering.QualityLevel = PG.quality end
        if PG.meshDetail then rendering.MeshPartDetailLevel = PG.meshDetail end
    end)
    PG.quality = nil; PG.meshDetail = nil
    pgRestoreAll(Lighting, PG.lighting)
    pgRestoreAll(Workspace.Terrain, PG.terrain)
    PG.queue = {}; PG.queueHead = 0; PG.workerActive = false
end

