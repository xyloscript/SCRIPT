local originalPartSizes = {}
local function rememberPartSize(part)
    if part and originalPartSizes[part] == nil then originalPartSizes[part] = part.Size end
end
local function restorePartSize(part)
    local original = part and originalPartSizes[part]
    if part and part.Parent and original then part.Size = original end
    if part then originalPartSizes[part] = nil end
end

local updateRealHitbox = function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            local root = char:FindFirstChild("HumanoidRootPart")
            if head then
                rememberPartSize(head)
                if tbl3.BigHead then
                    head.Size = Vector3.new(tbl3.BigHeadSize, tbl3.BigHeadSize, tbl3.BigHeadSize)
                    head.CanCollide = false
                    local mesh = head:FindFirstChildOfClass("SpecialMesh")
                    if mesh then mesh.Scale = Vector3.new(tbl3.BigHeadSize, tbl3.BigHeadSize, tbl3.BigHeadSize) end
                else
                    restorePartSize(head)
                    local mesh = head:FindFirstChildOfClass("SpecialMesh")
                    if mesh then mesh.Scale = Vector3.new(1, 1, 1) end
                end
            end
            if root then
                rememberPartSize(root)
                if tbl3.HitboxExpander then
                    root.Size = Vector3.new(tbl3.HitboxSize, tbl3.HitboxSize, tbl3.HitboxSize)
                    root.Transparency = 0.7
                    root.CanCollide = false
                else
                    restorePartSize(root)
                    root.Transparency = 1
                end
            end
        end
    end
end

