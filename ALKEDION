local TriggerbotLastShot = 0
local TriggerbotLastTarget = nil
local TriggerbotFirstSeen = 0

local function triggerbotShoot()
    local now = os.clock()
    if now - TriggerbotLastShot < tbl3.TriggerbotInterval then return end
    local character = localPlayer.Character
    if not character then return end
    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return end
    TriggerbotLastShot = now
    pcall(function() tool:Activate() end)
    task.delay(0.03, function()
        if tool and tool.Parent == character then pcall(function() tool:Deactivate() end) end
    end)
end

local function getTarget(fovRadius)
    local center = currentCamera.ViewportSize / 2
    local bestPlayer = nil
    local bestDistance = math.huge
    fovRadius = fovRadius or tbl3.FOV
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer then
            local char = player.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and hrp then
                    local part = char:FindFirstChild(tbl3.BodyPart) or hrp
                    local screenPosition, visible = currentCamera:WorldToViewportPoint(part.Position)
                    if visible and screenPosition.Z > 0 then
                        local dx = screenPosition.X - center.X
                        local dy = screenPosition.Y - center.Y
                        local distance = math.sqrt(dx * dx + dy * dy)
                        if distance <= fovRadius and distance < bestDistance then
                            bestDistance = distance
                            bestPlayer = player
                        end
                    end
                end
            end
        end
    end
    return bestPlayer
end

