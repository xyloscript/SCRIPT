local PG = {
    enabled = false, generation = 0,
    quality = nil, meshDetail = nil,
    lighting = {}, terrain = {},
    queue = {}, queueHead = 0, workerActive = false,
}
local PG_LightingTargets = {
    GlobalShadows = false, FogStart = 9000000000, FogEnd = 9000000000,
    Brightness = 0.5, Ambient = Color3.fromRGB(180,180,180), OutdoorAmbient = Color3.fromRGB(180,180,180),
    ShadowSoftness = 0, EnvironmentDiffuseScale = 0, EnvironmentSpecularScale = 0, ExposureCompensation = 0,
}
local PG_TerrainTargets = {
    WaterWaveSize = 0, WaterWaveSpeed = 0, WaterReflectance = 0, WaterTransparency = 0, Decoration = false,
}
local function pgRestoreAll(inst, saved)
    for k, v in pairs(saved) do
        pcall(function() inst[k] = v end)
        saved[k] = nil
    end
end
local function pgOverride(inst, saved, targets)
    for k, v in pairs(targets) do
        local ok, cur = pcall(function() return inst[k] end)
        if ok then
            if saved[k] == nil then saved[k] = cur end
            pcall(function() inst[k] = v end)
        end
    end
end
local function pgWorker(gen)
    while PG.enabled and PG.generation == gen do
        task.wait()
        if PG.generation ~= gen then break end
        local t0 = os.clock()
        while PG.queueHead > 0 do
            PG.queue[PG.queueHead] = nil
            PG.queueHead = PG.queueHead - 1
            if os.clock() - t0 > 0.004 then break end
        end
        if PG.queueHead == 0 then break end
    end
    if PG.generation == gen then PG.workerActive = false end
end
function PG.Enable()
    if PG.enabled then return end
    PG.enabled = true
    PG.generation = PG.generation + 1
    local rendering = settings().Rendering
    pcall(function()
        PG.quality = rendering.QualityLevel
        PG.meshDetail = rendering.MeshPartDetailLevel
    end)
    pcall(function() rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    pcall(function() rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01 end)
    pgOverride(Lighting, PG.lighting, PG_LightingTargets)
    pgOverride(Workspace.Terrain, PG.terrain, PG_TerrainTargets)
    PG.queue = {}; PG.queueHead = 0
    for _, inst in ipairs(Lighting:GetDescendants()) do PG.queueHead = PG.queueHead + 1; PG.queue[PG.queueHead] = inst end
    for _, inst in ipairs(Workspace:GetDescendants()) do PG.queueHead = PG.queueHead + 1; PG.queue[PG.queueHead] = inst end
    PG.workerActive = true
    task.spawn(pgWorker, PG.generation)
end
function PG.Disable()
    if not PG.enabled then return end
    PG.enabled = false
    PG.generation = PG.generation + 1
    pcall(function()
        local rendering = settings().Rendering
        if PG.quality then rendering.QualityLevel = PG.quality end
        if PG.meshDetail then rendering.MeshPartDetailLevel = PG.meshDetail end
    end)
    PG.quality = nil; PG.meshDetail = nil
    pgRestoreAll(Lighting, PG.lighting)
    pgRestoreAll(Workspace.Terrain, PG.terrain)
    PG.queue = {}; PG.queueHead = 0; PG.workerActive = false
end

