local IgnoreKeywords = {"hit", "impact", "flesh", "damage", "headshot", "hitmark"}
local function checkSound(obj)
    if obj:IsA("Sound") then
        local name = string.lower(obj.Name)
        local isDefault = false
        for _, kw in ipairs(IgnoreKeywords) do
            if string.find(name, kw) then isDefault = true; break end
        end
        if obj.Parent and (obj.Parent:IsA("PlayerCharacter") or obj.Parent.Parent == workspace) then
            if obj.Parent ~= localPlayer.Character and not obj.Parent:IsDescendantOf(localPlayer.Character) then
                isDefault = true
            end
        end
        if isDefault then
            obj.Volume = 0
            obj.Playing = false
        end
    end
end
