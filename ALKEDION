local PG = {
    enabled = false, generation = 0,
    quality = nil, meshDetail = nil,
    lighting = {}, terrain = {},
    queue = {}, queueHead = 0, workerActive = false,
}
local PG_LightingTargets = {
    GlobalShadows = false, FogStart = 9000000000, FogEnd = 9000000000,
    Brightness = 0.5, Ambient = Color3.fromRGB(180,180,180), OutdoorAmbient = Color3.fromRGB(180,180,180),
    ShadowSoftness = 0, EnvironmentDiffuseScale = 0, EnvironmentSpecularScale = 0, ExposureCompensation = 0,
}
local PG_TerrainTargets = {
    WaterWaveSize = 0, WaterWaveSpeed = 0, WaterReflectance = 0, WaterTransparency = 0, Decoration = false,
}

local function pgApply(inst, key, val)
    pcall(function() inst[key] = val end)
end
local function pgRestoreAll(inst, saved)
    for k, v in pairs(saved) do
        pcall(function() inst[k] = v end)
        saved[k] = nil
    end
end
local function pgOverride(inst, saved, targets)
    for k, v in pairs(targets) do
        local ok, cur = pcall(function() return inst[k] end)
        if ok then
            if saved[k] == nil then saved[k] = cur end
            pcall(function() inst[k] = v end)
        end
    end
end

local function pgWorker(gen)
    while PG.enabled and PG.generation == gen do
        task.wait()
        if PG.generation ~= gen then break end
        local t0 = os.clock()
        while PG.queueHead > 0 do
            PG.queue[PG.queueHead] = nil
            PG.queueHead = PG.queueHead - 1
            if os.clock() - t0 > 0.004 then break end
        end
        if PG.queueHead == 0 then break end
    end
    if PG.generation == gen then PG.workerActive = false end
end

local function pgPush(inst)
    PG.queueHead = PG.queueHead + 1
    PG.queue[PG.queueHead] = inst
    if not PG.workerActive then
        PG.workerActive = true
        task.spawn(pgWorker, PG.generation)
    end
end

