local function auraClearAll()
    for _, v in ipairs(AuraState.attached) do
        pcall(function() v:Destroy() end)
    end
    table.clear(AuraState.attached)
end

local function auraTint(root, color)
    local seq = ColorSequence.new(color)
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("PointLight") then d.Color = color
        elseif d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") then d.Color = seq end
    end
end

local function auraApplyParticle(cfg)
    local ok, template = pcall(function() return game:GetObjects(cfg.id)[1] end)
    if not ok or not template then warn("[aura] failed to load " .. cfg.name); return end
    local char = localPlayer.Character
    if not char then return end
    local clone = template:Clone()
    auraTint(clone, AURA_CYAN)
    for _, group in ipairs(clone:GetChildren()) do
        local part = char:FindFirstChild(group.Name)
        if part then
            for _, obj in ipairs(group:GetChildren()) do
                obj.Parent = part
                table.insert(AuraState.attached, obj)
            end
        end
    end
    clone:Destroy()
end

