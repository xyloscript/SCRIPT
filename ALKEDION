local function getCameraTPRotation(camera)
    local x, y, _ = camera.CFrame:ToOrientation()
    CameraTPPitch = math.clamp(x, math.rad(-88), math.rad(88))
    CameraTPYaw = y
end

local function stopCameraTP(restoreCamera)
    local camera = Workspace.CurrentCamera
    tbl3.CameraTPActive = false
    local char = localPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        root.Anchored = false
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    if humanoid then humanoid.PlatformStand = false; humanoid.AutoRotate = true end
    if restoreCamera and camera then
        camera.CameraType = tbl3.CameraTPOriginalType or Enum.CameraType.Custom
        if tbl3.CameraTPOriginalSubject and tbl3.CameraTPOriginalSubject.Parent then
            camera.CameraSubject = tbl3.CameraTPOriginalSubject
        elseif humanoid then camera.CameraSubject = humanoid end
    end
    tbl3.CameraTPOriginalType = nil
    tbl3.CameraTPOriginalSubject = nil
    if CameraTPButton then CameraTPButton.Text = "TP CAM"; CameraTPButton.BackgroundColor3 = tbl5.accent end
end

local function startCameraTP()
    if not tbl3.ViewCameraTP then return end
    local char = localPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local camera = Workspace.CurrentCamera
    if not humanoid or not root or not camera then return end
    if tbl3.CameraTPActive then
        local cameraPosition = camera.CFrame.Position
        local look = camera.CFrame.LookVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        if flatLook.Magnitude < 0.001 then flatLook = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z) end
        if flatLook.Magnitude < 0.001 then flatLook = Vector3.new(0, 0, -1) end
        root.Anchored = false
        root.CFrame = CFrame.lookAt(cameraPosition, cameraPosition + flatLook.Unit)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        stopCameraTP(true)
        return
    end
    tbl3.CameraTPOriginalType = camera.CameraType
    tbl3.CameraTPOriginalSubject = camera.CameraSubject
    tbl3.CameraTPActive = true
    getCameraTPRotation(camera)
    root.Anchored = true
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    humanoid.PlatformStand = false; humanoid.AutoRotate = false
