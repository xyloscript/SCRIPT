    vl.Text = string.format(step < 1 and "%.2f" or "%d", initV)
    vl.TextColor3 = tbl5.accentHi; vl.TextSize = 12; vl.Font = Enum.Font.GothamBold
    vl.TextXAlignment = Enum.TextXAlignment.Right; vl.ZIndex = 8
    local track = Instance.new("Frame", row)
    track.Size = UDim2.new(1,-24,0,4); track.Position = UDim2.new(0,12,0,34)
    track.BackgroundColor3 = tbl5.bgHi; track.BorderSizePixel = 0; track.ZIndex = 8
    Instance.new("UICorner", track).CornerRadius = UDim.new(1,0)
    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new((initV-minV)/(maxV-minV),0,1,0)
    fill.BackgroundColor3 = tbl5.accent; fill.BorderSizePixel = 0; fill.ZIndex = 9
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1,0)
    local thumb = Instance.new("Frame", track)
    thumb.Size = UDim2.new(0,12,0,12)
    thumb.Position = UDim2.new((initV-minV)/(maxV-minV),-6,0.5,-6)
    thumb.BackgroundColor3 = tbl5.white; thumb.BorderSizePixel = 0; thumb.ZIndex = 10
    Instance.new("UICorner", thumb).CornerRadius = UDim.new(1,0)
    local dragging = false
    local function upd(x)
        local px = track.AbsolutePosition.X; local sx = track.AbsoluteSize.X
        if sx <= 0 then return end
        local t = math.clamp((x-px)/sx, 0, 1)
        local raw = minV + t*(maxV-minV)
        local sn = math.clamp(math.floor(raw/step+0.5)*step, minV, maxV)
        local finalT = (sn-minV)/(maxV-minV)
        fill.Size = UDim2.new(finalT,0,1,0); thumb.Position = UDim2.new(finalT,-6,0.5,-6)
        vl.Text = string.format(step < 1 and "%.2f" or "%d", sn)
        cb(sn)
    end
    thumb.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then dragging = true end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch) then upd(i.Position.X) end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            if dragging then dragging = false; fn() end
        end
    end)
    return row
end

local function makePillSelector(parent, text, options, currentValue, cb)
    local row = makeRow(parent, 36)
    local lb = Instance.new("TextLabel", row)
    lb.Size = UDim2.new(1,-100,1,0); lb.Position = UDim2.new(0,14,0,0)
    lb.BackgroundTransparency = 1; lb.Text = text; lb.TextColor3 = tbl5.text
    lb.TextSize = 12; lb.Font = Enum.Font.GothamMedium
    lb.TextXAlignment = Enum.TextXAlignment.Left; lb.ZIndex = 11
    local btn = Instance.new("TextButton", row)
    btn.Size = UDim2.new(0,80,0,22); btn.Position = UDim2.new(1,-90,0.5,-11)
    btn.BackgroundColor3 = tbl5.bgHi; btn.BorderSizePixel = 0
    btn.Text = currentValue; btn.TextColor3 = tbl5.accentHi
    btn.TextSize = 11; btn.Font = Enum.Font.GothamBold; btn.ZIndex = 11
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,6)
    local ps = Instance.new("UIStroke", btn); ps.Color = tbl5.border; ps.Thickness = 1

    local container = Instance.new("ScrollingFrame", sg)
    container.Name = "DropDown_" .. text
    container.BackgroundColor3 = tbl5.bgHi
    container.BorderSizePixel = 0; container.ZIndex = 999
    container.Visible = false; container.ClipsDescendants = true
    container.ScrollBarThickness = 2
    container.ScrollBarImageColor3 = tbl5.accent
    container.AutomaticCanvasSize = Enum.AutomaticSize.Y
    container.CanvasSize = UDim2.new(0,0,0,0)
    Instance.new("UICorner", container).CornerRadius = UDim.new(0,6)
    local cStroke = Instance.new("UIStroke", container); cStroke.Color = tbl5.border
    local cList = Instance.new("UIListLayout", container)
    cList.Padding = UDim.new(0,2); cList.SortOrder = Enum.SortOrder.LayoutOrder
    local cPadding = Instance.new("UIPadding", container)
    cPadding.PaddingTop = UDim.new(0,4); cPadding.PaddingBottom = UDim.new(0,4)
    cPadding.PaddingLeft = UDim.new(0,4); cPadding.PaddingRight = UDim.new(0,4)

    for i, opt in ipairs(options) do
        local optBtn = Instance.new("TextButton", container)
        optBtn.Size = UDim2.new(1,0,0,24); optBtn.BackgroundColor3 = tbl5.bgRow
        optBtn.BorderSizePixel = 0; optBtn.Text = opt; optBtn.TextColor3 = tbl5.text
        optBtn.TextSize = 12; optBtn.Font = Enum.Font.GothamMedium; optBtn.ZIndex = 1000; optBtn.LayoutOrder = i
        Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0,4)
        optBtn.MouseEnter:Connect(function() TweenService:Create(optBtn, TweenInfo.new(0.1), {BackgroundColor3 = tbl5.bgRowHi}):Play() end)
        optBtn.MouseLeave:Connect(function() TweenService:Create(optBtn, TweenInfo.new(0.1), {BackgroundColor3 = tbl5.bgRow}):Play() end)
        optBtn.MouseButton1Click:Connect(function()
            btn.Text = opt
            cb(opt)
            closeOpenDropdown()
        end)
    end

    btn.MouseButton1Click:Connect(function()
        if OPEN_DROPDOWN == container then
            closeOpenDropdown()
            return
        end
        closeOpenDropdown()

        local absPos = btn.AbsolutePosition
        local absSize = btn.AbsoluteSize

        local listW = math.max(absSize.X, 120)
        local listH = math.min(#options * 26 + 8, 180)
        local vp = currentCamera.ViewportSize
        local px = math.clamp(absPos.X, 4, vp.X - listW - 4)
        local py = absPos.Y + absSize.Y + 4
        if py + listH > vp.Y - 4 then
            py = absPos.Y - listH - 4
        end

        container.Position = UDim2.fromOffset(px, py)
        container.Size = UDim2.fromOffset(listW, listH)
        container.Visible = true
        container.ZIndex = 999
        OPEN_DROPDOWN = container
    end)

    row.MouseEnter:Connect(function() TweenService:Create(row, TweenInfo.new(0.12), { BackgroundColor3 = tbl5.bgRowHi }):Play() end)
    row.MouseLeave:Connect(function() TweenService:Create(row, TweenInfo.new(0.12), { BackgroundColor3 = tbl5.bgRow }):Play() end)
    return row
end

